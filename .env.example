# Server-side only. Never expose these to the browser.
# Render API key with access to the workspace that owns the workflow service.
RENDER_API_KEY=
# Slug of the Render Workflow service (shown on the task page as <slug>/cash-flow-integrity-check).
WORKFLOW_SLUG=marlo-workflows
# Port for the Node server (Render sets this automatically).
PORT=3000
# Postgres connection string (Render sets it from the harbor-db database). Locally, for example:
# docker run -p 5433:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=harbor postgres:16
DATABASE_URL=postgres://postgres:dev@localhost:5433/harbor
# Optional: creates the demo login demo@harbor.example with the sample data on first start.
DEMO_PASSWORD=
